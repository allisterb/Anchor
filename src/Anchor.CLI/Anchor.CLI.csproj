<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Anchor.CLI</RootNamespace>

    <!-- No AssemblyName override, deliberately. `anchor` is the launcher script at the repo
         root, which dispatches the verb to this assembly or to Python; naming the assembly the
         same thing puts two files called `anchor` on one PATH, and in the container image the
         published self-contained binary IS one of them.

         AssemblyTitle is the compensation, and it is not cosmetic. CommandLineParser builds its
         banner from AssemblyTitleAttribute when there is one and from the assembly name otherwise,
         so without this `anchor version` and `anchor help` answer "Anchor.CLI" to somebody who
         typed `anchor`, naming a file they never invoked and cannot find on PATH. Version is
         mapped to the shared property in Directory.Build.props rather than restated. -->
    <AssemblyTitle>Anchor</AssemblyTitle>
    <!-- CopyrightInfo reads AssemblyCompanyAttribute, which defaults to the assembly name.
         Left alone the help banner credits the copyright to a file. -->
    <Company>Allister Beharry</Company>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anchor.MCPServer\Anchor.MCPServer.csproj" />
    <ProjectReference Include="..\Anchor.Runtime\Anchor.Runtime.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
  </ItemGroup>

</Project>
