// Minimal schema for the SessionRotation policy, modelled on the corpus schemas.
namespace Anchor {
  type SystemContext = {
    now: datetime
  };

  type TradeInput = {
    amount: Long
  };

  type ScoreInput = {
    user: String
  };

  type ScoreOutput = {
    score: decimal,
    count: Long
  };

  type TradeOutput = {
    result: Bool
  };

  type ApproveInput = {
    approver: String
  };

  type ApproveOutput = {
    result: Bool
  };

  entity Gateway;

  entity OAuthUser = {
    id: String
  } tags String;

  action "CallTool";

  action "Trade" in [Action::"CallTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: TradeInput,
      output?: TradeOutput,
      system: SystemContext
    }
  };

  // A decimal output beside a Long one, so an ordering comparison can be asked of both in the
  // same shape. `dogwood_replay` uses the pair to pin that ordering on a decimal is FALSE.
  action "Score" in [Action::"CallTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ScoreInput,
      output?: ScoreOutput,
      system: SystemContext
    }
  };

  action "Approve" in [Action::"CallTool"] appliesTo {
    principal: [OAuthUser],
    resource: [Gateway],
    context: {
      input: ApproveInput,
      output?: ApproveOutput,
      system: SystemContext
    }
  };
}
